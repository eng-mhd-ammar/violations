// use prisma-next

model User {
  id        Int      @id @default(autoincrement())

  username  String
  phone     String
  password  String

  firstName String
  lastName  String

  isActive  Boolean  @default(true)

  branchId  Int?

  branch    Branch? @relation(fields: [branchId], references: [id])

  userRoles UserRole[]

  violationsAsOfficer Violation[] @relation("ViolationOfficer")

  objectionsAsApplicant Objection[] @relation("ObjectionApplicant")
  objectionsAsReviewer  Objection[] @relation("ObjectionReviewer")

  paymentsAsAccountant Payment[] @relation("PaymentAccountant")

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt Timestamptz?

  @@index([branchId])
  @@index([isActive])

  @@map("users")
}

model Role {
  id              Int      @id @default(autoincrement())

  name            String
  slug            String
  description     String?

  isActive        Boolean  @default(true)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt       Timestamptz?

  @@unique([slug])
  @@index([isActive])

  @@map("roles")
}

model Permission {
  id              Int      @id @default(autoincrement())

  name            String
  slug            String
  description     String?

  rolePermissions RolePermission[]

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt       Timestamptz?

  @@unique([slug])

  @@map("permissions")
}

model UserRole {
  id        Int  @id @default(autoincrement())

  userId    Int
  roleId    Int

  user      User @relation(fields: [userId], references: [id])
  role      Role @relation(fields: [roleId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt TimestamptzString?

  @@index([userId])
  @@index([roleId])
  @@unique([userId, roleId])

  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())

  roleId       Int
  permissionId Int

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())
  deletedAt    TimestamptzString?

  @@index([roleId])
  @@index([permissionId])
  @@unique([roleId, permissionId])

  @@map("role_permissions")
}

model Branch {
  id        Int    @id @default(autoincrement())

  name      String
  phone     String
  code      String

  addressId Int

  address   Address @relation(fields: [addressId], references: [id])

  users      User[]
  violations Violation[] @relation("BranchViolations")
  payments   Payment[]

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt Timestamptz?

  @@index([addressId])
  @@index([code])

  @@map("branches")
}

model State {
  id        Int      @id @default(autoincrement())

  name      String

  addresses Address[]

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt Timestamptz?

  @@map("states")
}

model Address {
  id        Int    @id @default(autoincrement())

  stateId   Int
  city      String
  street    String

  state     State     @relation(fields: [stateId], references: [id])
  branches  Branch[]
  citizens  Citizen[]

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt Timestamptz?

  @@index([stateId])

  @@map("addresses")
}

model Currency {
  id        Int    @id @default(autoincrement())

  name      String
  code      String

  violations Violation[] @relation("CurrencyViolations")
  payments   Payment[]

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt Timestamptz?

  @@unique([code])

  @@map("currencies")
}

model ViolationType {
  id          Int      @id @default(autoincrement())

  name        String
  description String?
  isActive    Boolean  @default(true)
  defaultFine Decimal

  violations Violation[] @relation("ViolationTypeViolations")

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt  Timestamptz?

  @@index([isActive])

  @@map("violation_types")
}

model Citizen {
  id          Int    @id @default(autoincrement())

  nationalId  String
  firstName   String
  lastName    String
  fatherName  String
  motherName  String
  dateOfBirth String
  phone       String

  addressId   Int

  address     Address @relation(fields: [addressId], references: [id])

  violations Violation[] @relation("CitizenViolations")

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  deletedAt Timestamptz?

  @@index([addressId])
  @@index([phone])

  @@map("citizens")
}

model Violation {
  id               Int      @id @default(autoincrement())

  violationNumber  String

  citizenId        Int
  violationTypeId  Int
  branchId         Int
  officerId        Int

  // Vehicle snapshot
  plateNumber      String
  plateCode        String
  plateCategory    String
  vehicleType      String
  make             String
  model            String
  color            String
  manufactureYear  Int

  status           String

  fineAmount       Decimal

  paidCurrencyId   Int?

  violationDate    TimestamptzString

  location         String?

  cancelledAt      TimestamptzString?

  citizen          Citizen       @relation(
    "CitizenViolations",
    fields: [citizenId],
    references: [id]
  )

  violationType    ViolationType @relation(
    "ViolationTypeViolations",
    fields: [violationTypeId],
    references: [id]
  )

  branch           Branch        @relation(
    "BranchViolations",
    fields: [branchId],
    references: [id]
  )

  officer          User          @relation(
    "ViolationOfficer",
    fields: [officerId],
    references: [id]
  )

  paidCurrency     Currency?     @relation(
    "CurrencyViolations",
    fields: [paidCurrencyId],
    references: [id]
  )

  objections      Objection[] @relation("ViolationObjections")
  payments        Payment[]
  attachments     Attachment[]

  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())
  deletedAt        Timestamptz?

  @@index([citizenId])
  @@index([violationTypeId])
  @@index([branchId])
  @@index([officerId])
  @@index([paidCurrencyId])

  @@index([plateNumber])
  @@index([violationDate])
  @@index([status])

  @@map("violations")
}

model Objection {
  id           Int      @id @default(autoincrement())

  violationId  Int

  applicantId  Int
  reviewerId   Int?

  reason       String
  description  String

  status       String

  reviewedAt   TimestamptzString?
  reviewNotes  String?

  violation    Violation @relation(
    "ViolationObjections",
    fields: [violationId],
    references: [id]
  )

  applicant    User @relation(
    "ObjectionApplicant",
    fields: [applicantId],
    references: [id]
  )

  reviewer     User? @relation(
    "ObjectionReviewer",
    fields: [reviewerId],
    references: [id]
  )

  attachments Attachment[]

  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())
  deletedAt    Timestamptz?

  @@index([violationId])
  @@index([applicantId])
  @@index([reviewerId])
  @@index([status])

  @@map("objections")
}

model Payment {
  id             Int      @id @default(autoincrement())

  receiptNumber  String

  accountantId   Int
  branchId       Int
  violationId    Int
  currencyId     Int

  amount         Decimal

  status         String

  paidAt         TimestamptzString

  notes          String?

  accountant     User @relation(
    "PaymentAccountant",
    fields: [accountantId],
    references: [id]
  )

  branch         Branch @relation(
    fields: [branchId],
    references: [id]
  )

  violation      Violation @relation(
    fields: [violationId],
    references: [id]
  )

  currency       Currency @relation(
    fields: [currencyId],
    references: [id]
  )

  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())
  deletedAt      Timestamptz?

  @@index([accountantId])
  @@index([branchId])
  @@index([violationId])
  @@index([currencyId])
  @@index([status])
  @@index([paidAt])

  @@map("payments")
}

model Attachment {
  id           Int      @id @default(autoincrement())

  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String

  objectionId  Int?
  violationId  Int?

  objection    Objection? @relation(
    fields: [objectionId],
    references: [id]
  )

  violation    Violation? @relation(
    fields: [violationId],
    references: [id]
  )

  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())
  deletedAt    Timestamptz?

  @@index([objectionId])
  @@index([violationId])

  @@map("attachments")
}