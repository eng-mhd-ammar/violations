// use prisma-next

model User {
  id        Int      @id @default(autoincrement())

  username  String 
  phone     String
  password  String

  firstName String
  lastName  String

  isActive  Boolean  @default(true)

  branchId  Int?

  branch    Branch? @relation(fields: [branchId], references: [id])

  userRoles UserRole[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() @default(now())
  deletedAt TimestamptzString? @default(null)

  @@map("users")
}

model Role {
  id              Int      @id @default(autoincrement())

  name            String
  slug            String
  description     String?

  isActive        Boolean  @default(true)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() @default(now())
  deletedAt TimestamptzString? @default(null)

  @@map("roles")
}

model Permission {
  id              Int      @id @default(autoincrement())

  name            String
  slug            String
  description     String?

  rolePermissions RolePermission[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() @default(now())
  deletedAt TimestamptzString? @default(null)

  @@map("permissions")
}

model UserRole {
  id        Int  @id @default(autoincrement())

  userId    Int
  roleId    Int

  user      User @relation(fields: [userId], references: [id])
  role      Role @relation(fields: [roleId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() @default(now())
  deletedAt TimestamptzString? @default(null)

  @@unique([userId, roleId])

  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())

  roleId       Int
  permissionId Int

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt    TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() @default(now())
  deletedAt TimestamptzString? @default(null)

  @@unique([roleId, permissionId])

  @@map("role_permissions")
}

model Branch {
  id        Int    @id @default(autoincrement())

  name      String
  code      String @unique

  users     User[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() @default(now())
  deletedAt TimestamptzString? @default(null)

  @@map("branches")
}

model State {
  id        Int      @id @default(autoincrement())

  name      String

  addresses Address[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() @default(now())
  deletedAt TimestamptzString? @default(null)

  @@map("states")
}

model Address {
  id        Int      @id @default(autoincrement())

  stateId   Int
  city      String
  street    String

  state     State    @relation(fields: [stateId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString() @default(now())
  deletedAt TimestamptzString? @default(null)

  @@map("addresses")
}